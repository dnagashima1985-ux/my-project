# ── Supabase (EU Frankfurt region — GDPR compliant) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude API ────────────────────────────────────────────────────────────────
# Model: claude-sonnet-4-6 (hardcoded in lib/claude/client.ts)
ANTHROPIC_API_KEY=sk-ant-...

# ── Data APIs ─────────────────────────────────────────────────────────────────
# TheStatsAPI Growth plan ($129/mo) — player stats, xG, xA, dribbles
STATS_API_KEY=your-stats-api-key

# API-Football (free tier) — injury data /injuries /sidelined
API_FOOTBALL_KEY=your-api-football-key

# ── EQ / Market Intelligence news ────────────────────────────────────────────
# NewsAPI ($49/mo) — article collection for EQ analysis and MI
NEWS_API_KEY=your-newsapi-key

# GNews (optional supplement)
GNEWS_API_KEY=your-gnews-key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these products in Stripe Dashboard
STRIPE_STARTER_PRICE_ID=price_...   # €7/mo
STRIPE_PRO_PRICE_ID=price_...       # €14/mo
STRIPE_ELITE_PRICE_ID=price_...     # €29/mo

# ── Email (Resend) ────────────────────────────────────────────────────────────
# resend.com — welcome email, trial low alerts, MI signal alerts
RESEND_API_KEY=re_...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://scoutiq.app

# ── Cron security ─────────────────────────────────────────────────────────────
# Random secret used to authenticate Vercel cron requests
# Generate: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
